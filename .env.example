# ---- Admin auth (required) ----
# Plain values. Vercel encrypts at rest; middleware compares in constant time.
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-long-random-string

# ---- RPC overrides (optional) ----
# If unset, dashboard falls back to the curated public-RPC pool per chain
# (mirrors the Z0tz relayer's resolution rules).
RPC_URL_84532=
RPC_URL_11155111=
RPC_URL_421614=

# ---- Event scan window (optional) ----
# Earliest block to scan per chain. Defaults to genesis of the relevant Z0tz
# deployment block. Lower this to extend history; raise to skip cold history.
SCAN_FROM_BLOCK_84532=
SCAN_FROM_BLOCK_11155111=
SCAN_FROM_BLOCK_421614=

# ---- Price feed (optional) ----
# CoinGecko works without a key but is rate-limited. Provide a demo key for
# higher limits.
COINGECKO_API_KEY=

# --- Block Explorer API Key (for native ETH tx history) ---
# One Etherscan V2 key works for Etherscan, Arbiscan, AND Basescan — including
# their Sepolia testnets. Get a free key at: https://etherscan.io/myapikey
#
# Captures the relayer's direct stealth-funding outflows (native ETH transfers
# that don't emit events). Without this key, the treasury panel UNDERSTATES
# relayer spend by 2-10× (paymaster gas only, no direct top-ups).
ETHERSCAN_API_KEY=

# Per-explorer overrides (optional). Fall back to ETHERSCAN_API_KEY above.
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
